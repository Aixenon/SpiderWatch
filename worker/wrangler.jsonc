{
  "name": "spider-watch",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "ratelimits": [
    {"name": "BOOTSTRAP_LIMITER", "namespace_id": "1001", "simple": {"limit": 120, "period": 60}},
    {"name": "BOOTSTRAP_ENROLL_LIMITER", "namespace_id": "1003", "simple": {"limit": 5, "period": 60}},
    {"name": "LOGIN_LIMITER", "namespace_id": "1005", "simple": {"limit": 10, "period": 60}}
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{"name": "MONITOR", "class_name": "MonitorGroup"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["MonitorGroup"]}],
  "vars": {
    "MONITOR_GROUP": "100000000001",
    "LOCAL_DEV": "false"
  },
  "observability": {
    "enabled": true,
    "logs": {"enabled": true, "head_sampling_rate": 0.01},
    "traces": {"enabled": true, "head_sampling_rate": 0.01}
  },
  "env": {
    "local": {
      "name": "spider-watch-local",
      "ratelimits": [
        {"name": "BOOTSTRAP_LIMITER", "namespace_id": "1002", "simple": {"limit": 120, "period": 60}},
        {"name": "BOOTSTRAP_ENROLL_LIMITER", "namespace_id": "1004", "simple": {"limit": 5, "period": 60}},
        {"name": "LOGIN_LIMITER", "namespace_id": "1006", "simple": {"limit": 10, "period": 60}}
      ],
      "vars": {
        "MONITOR_GROUP": "100000000001",
        "UPDATE_GITHUB_REPOSITORY": "",
        "GITHUB_CLIENT_ID": "",
        "ADMIN_GITHUB_IDS": "",
        "LOCAL_DEV": "true"
      },
      "durable_objects": {"bindings": [{"name": "MONITOR", "class_name": "MonitorGroup"}]}
    }
  }
}
