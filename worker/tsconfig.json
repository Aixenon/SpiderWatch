  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022"], "strict": true, "noEmit": true,
    "resolveJsonModule": true, "skipLibCheck": true, "types": ["node", "@cloudflare/vitest-plugin/types"]
