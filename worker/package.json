{
  "name": "spider-watch-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env local --ip 127.0.0.1",
    "types": "wrangler types --strict-vars=false",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "node scripts/deploy.mjs",
    "setup": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "4.147.0"
  }
}
